generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Todo {
  id           Int       @id @default(autoincrement())
  tezt         String    @db.VarChar(255)
  completedAt  DateTime?
}